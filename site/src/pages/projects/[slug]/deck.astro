---
// A project's deck: content/projects/<slug>/deck.md as one beat per screen, the
// visual beside the text. A beat without a visual keeps the last one up. For
// telling the project to someone in a straight line; see src/lib/deck.mjs.
import '../../../styles/site.css';
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import { SITE_NAME, deckFile, figuresOf, getProjects, projectUrl, shortTitle, url, type Figure, type Project } from '../../../lib/content';
import { deckSections, parseDeck, visualKind } from '../../../lib/deck.mjs';

export async function getStaticPaths() {
  const projects = await getProjects();
  const paths = [];
  for (const project of projects) {
    const file = deckFile(project.id);
    if (!file) continue;
    const { remarkPluginFrontmatter } = await render(project);
    paths.push({ params: { slug: project.id }, props: { project, file, figures: figuresOf(remarkPluginFrontmatter) } });
  }
  return paths;
}

const { project, file, figures } = Astro.props as { project: Project; file: string; figures: Figure[] };
const { beats } = parseDeck(fs.readFileSync(file, 'utf8'));
if (beats.length === 0) throw new Error(`${file}: no beats. A beat starts with "## headline".`);
const sections = deckSections(beats);
const md = unified().use(remarkParse).use(remarkRehype).use(rehypeStringify);
const bodies = await Promise.all(beats.map(async (b) => String(await md.process(b.body))));

/** The HTML of a beat's own visual. A missing file or figure stops the build. */
function visualHtml(src: string): string {
  const kind = visualKind(src);
  if (kind === 'figure') {
    const f = figures.find((x) => x.id === src.slice(1));
    if (!f) throw new Error(`${file}: no figure "${src}" in the writeup. It has: ${figures.map((x) => '#' + x.id).join(', ')}`);
    return f.html.replace(/\sid="[^"]*"/, '');
  }
  const rel = decodeURI(src).replace(/^\.\//, '');
  if (!fs.existsSync(path.join(path.dirname(file), rel))) throw new Error(`${file}: no file "${src}" next to it.`);
  const href = url(`/projects/${project.id}/${rel.split('/').map(encodeURIComponent).join('/')}`);
  return kind === 'video'
    ? `<video controls muted loop playsinline src="${href}"></video>`
    : `<img src="${href}" alt="">`;
}
const title = shortTitle(project);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{`Deck: ${title} · ${SITE_NAME}`}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="deck">
    <header class="deck-bar mono">
      <a href={projectUrl(project)}>{title}</a>
      <ol class="deck-sections plain">
        {sections.map((s) => <li data-section={s}>{s}</li>)}
      </ol>
      <span class="deck-count"><span data-n>1</span> / {beats.length}</span>
    </header>
    <main class="deck-main">
      <div class="deck-text">
        {beats.map((b, i) => (
          <section class="beat" id={String(i + 1)} data-section={b.section} data-shown={b.shown}>
            <h2>{b.headline}</h2>
            <div class="prose" set:html={bodies[i]} />
          </section>
        ))}
      </div>
      <div class="deck-visuals">
        {beats.map((b, i) => b.visual && (
          <figure class="deck-visual" data-beat={i}>
            <div class="prose" set:html={visualHtml(b.visual.src)} />
            {b.visual.caption && <figcaption>{b.visual.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </main>
    <nav class="deck-nav mono" aria-label="Beats">
      <button type="button" data-go="-1">back</button>
      <button type="button" data-go="1">next</button>
    </nav>
    <script is:inline>
      // One beat at a time. Without this script the page is every beat in order.
      (function () {
        var beats = Array.prototype.slice.call(document.querySelectorAll('.beat'));
        var visuals = Array.prototype.slice.call(document.querySelectorAll('.deck-visual'));
        var sections = Array.prototype.slice.call(document.querySelectorAll('.deck-sections li'));
        var count = document.querySelector('[data-n]');
        var at = 0;
        document.body.classList.add('js');
        function show(i, quiet) {
          at = Math.max(0, Math.min(beats.length - 1, i));
          var b = beats[at];
          beats.forEach(function (x, j) { x.hidden = j !== at; });
          visuals.forEach(function (v) {
            var on = v.getAttribute('data-beat') === b.getAttribute('data-shown');
            v.hidden = !on;
            v.querySelectorAll('video').forEach(function (m) {
              if (on) { var p = m.play(); if (p && p.catch) p.catch(function () {}); } else m.pause();
            });
          });
          sections.forEach(function (s) {
            if (s.getAttribute('data-section') === b.getAttribute('data-section')) s.setAttribute('aria-current', 'step');
            else s.removeAttribute('aria-current');
          });
          count.textContent = String(at + 1);
          if (!quiet) history.replaceState(null, '', '#' + (at + 1));
        }
        document.querySelectorAll('[data-go]').forEach(function (btn) {
          btn.addEventListener('click', function () { show(at + Number(btn.getAttribute('data-go'))); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.altKey || e.ctrlKey || e.metaKey) return;
          var t = e.target;
          if (t && t.closest && t.closest('input, textarea, select, video, [role="group"]')) return;
          var k = e.key;
          if (k === 'ArrowRight' || k === 'ArrowDown' || k === 'PageDown' || k === ' ' || k === 'j') show(at + 1);
          else if (k === 'ArrowLeft' || k === 'ArrowUp' || k === 'PageUp' || k === 'k') show(at - 1);
          else if (k === 'Home') show(0);
          else if (k === 'End') show(beats.length - 1);
          else return;
          e.preventDefault();
        });
        window.addEventListener('hashchange', function () { show((parseInt(location.hash.slice(1), 10) || 1) - 1, true); });
        show((parseInt(location.hash.slice(1), 10) || 1) - 1, true);
      })();
    </script>
  </body>
</html>
