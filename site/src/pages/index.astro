---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import {
  STATUS_LABEL,
  getEntries,
  getProjects,
  homeProjects,
  isoDate,
  latestEntryByProject,
  projectUrl,
  shortTitle,
} from '../lib/content';

const projects = await getProjects();
const latest = latestEntryByProject(await getEntries(projects));
// Every project is one row in the text column: cover at left, then title, result, status.
// The featured ones (in `featured` order) get a larger cover and a hook line; nothing else differs.
// Parts are linked from their parent's block.
const { featured, rest, children } = homeProjects(projects);
const blocks = [...featured.map((p) => ({ p, featured: true })), ...rest.map((p) => ({ p, featured: false }))];
---
<Base description="I'm a third-year Mechanical Engineering student at the University of Toronto. I build end-to-end electromechanical systems.">
  <div class="intro">
    <p>I'm a third-year Mechanical Engineering student at the University of Toronto. I build end-to-end electromechanical systems.</p>
    <p>I believe in first-principles empiricism: derive constraints from physics, then expand knowns through controlled iteration. This helps me design and solve problems in a grounded and quick fashion.</p>
  </div>

  <section class="projects" aria-label="Projects">
    {blocks.map(({ p, featured: isFeatured }, i) => {
      const href = projectUrl(p);
      const parts = children.get(p.id) ?? [];
      const last = latest.get(p.id);
      return (
        <>
          {i === featured.length && i > 0 && <hr />}
          <article class={isFeatured ? 'project featured' : 'project'}>
            {p.data.cover && (
              <a href={href} class="cover-link" tabindex="-1" aria-hidden="true">
                <Image
                  src={p.data.cover}
                  alt=""
                  width={isFeatured ? 900 : 450}
                  widths={isFeatured ? [300, 600, 900, 1360] : [150, 300, 450]}
                  sizes={isFeatured ? '(min-width: 760px) 300px, calc(100vw - 32px)' : '(min-width: 760px) 150px, 120px'}
                  format="webp"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  class="cover"
                />
              </a>
            )}
            <div class="project-text">
              <h2><a href={href}>{shortTitle(p)}</a></h2>
              {p.data.result && <p>{p.data.result}</p>}
              {parts.map((q, n) => (
                <p>Part {n + 2}: <a href={projectUrl(q)}>{shortTitle(q)}</a></p>
              ))}
              {isFeatured && p.data.hook && <p>{p.data.hook.label}: {p.data.hook.text}</p>}
              <p class="meta mono">
                {STATUS_LABEL[p.data.status]}
                {last && (
                  <>
                    {' · last entry '}
                    <time datetime={isoDate(last.data.date)}>{isoDate(last.data.date)}</time>
                  </>
                )}
              </p>
            </div>
          </article>
        </>
      );
    })}
  </section>
</Base>
