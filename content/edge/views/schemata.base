filters:
  and:
    - file.folder.endsWith("schemata")
properties:
  confidence:
    displayName: Conf
  cold:
    displayName: Cold
  modes:
    displayName: Modes held
  domain:
    displayName: Domain
  drill_next:
    displayName: Next drill
views:
  - type: table
    name: Where knowledge sits
    groupBy:
      property: cold
      direction: DESC
    order:
      - file.name
      - confidence
      - cold
      - modes
      - domain
      - drill_next
  - type: table
    name: Not yet cold
    filters:
      and:
        - cold == false
    order:
      - file.name
      - confidence
      - modes
      - drill_next
  - type: cards
    name: By domain
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - confidence
      - cold
